COMPOSE_PROJECT_NAME=campus-deploy
INSTANCE_ID=campus-deploy-local
ADMIN_ORIGIN=http://localhost:3000
BASE_DOMAIN=localhost
SITE_SCHEME=http
SITE_PORT=8080
SITE_BIND=127.0.0.1
BUILD_IMAGE=node:24.11.1-bookworm-slim
UPLOAD_LIMIT_MIB=50
EXTRACT_LIMIT_MIB=200
ARTIFACT_LIMIT_MIB=100
FILE_LIMIT=10000
BUILD_TIMEOUT_SECONDS=600
MIN_FREE_MIB=1024
HEALTH_TIMEOUT_SECONDS=30
